generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum GamePhase {
  REGISTRATION
  PHASE_1
  PHASE_2
  FINALE
  COMPLETE
}

enum QuestionPhase {
  PHASE_1
  PHASE_2
}

enum QuestionType {
  MCQ
  PREDICT_OUTPUT
  DEBUG
  WHICH_CODE_WORKS
  WHAT_WOULD_YOU_CHANGE
  SCENARIO
  MULTI_CONCEPT
}

enum LifelineType {
  FIFTY_FIFTY
  ASK_AUDIENCE
  ASK_EXPERT
  SWITCH_QUESTION
}

// ── Models ───────────────────────────────────────────────────────────────

model Event {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  teams     Team[]
  questions Question[]
  gameState GameState?
}

model Team {
  id          String   @id @default(cuid())
  name        String
  leaderName  String
  pin         String
  score       Int      @default(0)
  eliminated  Boolean  @default(false)
  createdAt   DateTime @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  answers        TeamAnswer[]
  lifelineUsages LifelineUsage[]
  activeInGame   GameState[]     @relation("ActiveTeam")

  @@unique([eventId, name])
  @@unique([eventId, pin])
}

model Question {
  id               String        @id @default(cuid())
  phase            QuestionPhase
  order            Int
  type             QuestionType
  text             String
  codeSnippet      String?
  options          String[]
  correctOption    Int
  points           Int           @default(1000)
  timeLimitSeconds Int?
  createdAt        DateTime      @default(now())
  // Set the instant a question becomes GameState.currentQuestion, whether or not it
  // ends up scored — a question is "used up" by being shown, not just by being
  // answered, so it can never be served again (round-robin or Switch Question).
  presentedAt      DateTime?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  answers               TeamAnswer[]
  lifelineUsagesOnThis  LifelineUsage[] @relation("OriginalQuestion")
  lifelineUsagesReplace LifelineUsage[] @relation("ReplacementQuestion")
  currentInGame         GameState[]     @relation("CurrentQuestion")

  @@unique([eventId, phase, order])
}

model GameState {
  id                String    @id @default(cuid())
  phase             GamePhase @default(REGISTRATION)
  questionStartedAt DateTime?
  questionRevealed  Boolean   @default(false)
  answerLocked      Boolean   @default(false)
  hiddenOptions     Int[]     @default([])
  // Round-robin position, independent of currentQuestion.order — Switch Question can
  // swap in a question with an unrelated order without disturbing whose turn it is.
  turnNumber        Int       @default(0)
  updatedAt         DateTime  @updatedAt

  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  currentQuestionId String?
  currentQuestion   Question? @relation("CurrentQuestion", fields: [currentQuestionId], references: [id])

  activeTeamId String?
  activeTeam   Team?   @relation("ActiveTeam", fields: [activeTeamId], references: [id])
}

model TeamAnswer {
  id             String   @id @default(cuid())
  selectedOption Int?
  isCorrect      Boolean  @default(false)
  pointsAwarded  Int      @default(0)
  submittedAt    DateTime @default(now())
  responseTimeMs Int?

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([teamId, questionId])
}

model LifelineUsage {
  id     String       @id @default(cuid())
  type   LifelineType
  usedAt DateTime     @default(now())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation("OriginalQuestion", fields: [questionId], references: [id], onDelete: Cascade)

  replacementQuestionId String?
  replacementQuestion   Question? @relation("ReplacementQuestion", fields: [replacementQuestionId], references: [id])

  @@unique([teamId, type])
}
