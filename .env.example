# Supabase Postgres (pooled connection for the app, direct connection for migrations)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ignitequest?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@localhost:5432/ignitequest"

# Supabase project (used only for Realtime broadcast, not for data access)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Host console auth
HOST_PASSWORD="change-me"
SESSION_SECRET="a-long-random-string-used-to-sign-session-cookies"

# The single Event this deployment runs. Created via `npm run db:seed`.
EVENT_ID="ignitequest-2026"

# Game config. Correct-answer points come from each Question's own `points` field
# (data/questions/*.json), not an env var — only the wrong-answer penalty is global.
FINALIST_COUNT="4"
PHASE1_TIME_LIMIT_SECONDS="60"
PHASE2_TIME_LIMIT_SECONDS="20"
WRONG_ANSWER_POINTS="0"
